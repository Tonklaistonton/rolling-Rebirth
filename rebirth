  echo
  printf "  \033[1;33m==[\033[0m \033[1;37mNotice: Browser & Profile Restoration Guide\033[0m \033[1;33m]==\033[0m\n"
  echo "  Ubuntu's default Firefox was installed via Snap and has been removed."
  if [ -n "${LAST_SNAP_BACKUP}" ]; then
    echo "  Your bookmarks, passwords, and user profile data were safely backed up to:"
    echo -e "    \033[1;36m${LAST_SNAP_BACKUP}\033[0m"
  else
    echo "  Your bookmarks, passwords, and user profile data are preserved in your ~/snap.bak.* directory."
  fi
  echo
  echo "  Recommended options to restore Firefox on Ubuntu (devel series):"
  echo
  echo "  Option 1 (Recommended): Install Firefox via Flatpak"
