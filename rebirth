function interactive_checklist () {
  local -a options=(
    "Track Ubuntu 'devel' series (Rolling Release)"
    "Purge Snap completely and block snapd (De-Snap)"
    "Install Flatpak with Flathub repository"
    "Disable active third-party PPAs & external repositories"
    "Install Dev Essentials (curl, git, build-essential, zsh, htop)"
    "Clean up obsolete packages & APT cache"
  )

  # Safe default: All unchecked (0) so user chooses explicitly
  local -a selected=(0 0 0 0 0 0)

  # Respect explicit CLI overrides if provided
  [ "${TRACK_DEVEL_CLI:-}" = "true" ] && selected[0]=1 || true
  [ "${PURGE_SNAP_CLI:-}" = "true" ] && selected[1]=1 || true
  [ "${INSTALL_FLATPAK_CLI:-}" = "true" ] && selected[2]=1 || true
  [ "${DISABLE_PPAS_CLI:-}" = "true" ] && selected[3]=1 || true
  [ "${DEV_TOOLS_CLI:-}" = "true" ] && selected[4]=1 || true
  [ "${CLEAN_SYSTEM_CLI:-}" = "true" ] && selected[5]=1 || true

  local cur=0
  local total=${#options[@]}

  ESC=$(printf "\033")
  UP="${ESC}[A"
  DOWN="${ESC}[B"

  # Hide cursor and ensure cleanup on exit / interrupt
  printf "\033[?25l"
  stty_state="$(stty -g 2>/dev/null || true)"
  restore_cursor() {
    printf "\033[?25h"
    [ -n "${stty_state:-}" ] && stty "${stty_state}" 2>/dev/null || true
  }
  handle_sigint() {
    restore_cursor
    echo
    fancy_message warn "Operation aborted by user."
    exit 130
  }
  trap handle_sigint INT TERM
  trap restore_cursor EXIT

  print_menu() {
    for i in "${!options[@]}"; do
      local mark=" "
      local color_mark="\033[1;30m"
      if [ "${selected[$i]}" -eq 1 ]; then
        mark="✔"
        color_mark="\033[1;32m"
      fi

      local prefix="    "
      local color_text="\033[0m"
      if [ "$i" -eq "$cur" ]; then
        prefix="  \033[1;36m➔ \033[0m"
        color_text="\033[1;37m"
      fi

      printf "\r${prefix}[${color_mark}%s\033[0m] ${color_text}%s\033[0m\033[K\n" "$mark" "${options[$i]}"
    done
  }

  echo
  printf "  \033[1;35m==[\033[0m \033[1;37mConfiguration Checklist\033[0m \033[1;35m]==\033[0m\n"
  printf "  \033[0;33mUse [↑/↓] or [j/k] to navigate, [Space] to toggle, [Enter] to confirm:\033[0m\n\n"
  print_menu

  while true; do
    local key=""
    IFS= read -rsn1 key || true
    if [ "$key" = "$ESC" ]; then
      local rest=""
      read -rsn2 -t 0.5 rest || true
      key+="${rest:-}"
    fi

    case "$key" in
      "$UP"|[kK])
        if [ "$cur" -gt 0 ]; then
          cur=$((cur - 1))
        else
          cur=$((total - 1))
        fi
        ;;
      "$DOWN"|[jJ])
        if [ "$cur" -lt $((total - 1)) ]; then
          cur=$((cur + 1))
        else
          cur=0
        fi
        ;;
      " ")
        if [ "${selected[$cur]}" -eq 1 ]; then
          selected[$cur]=0
        else
          selected[$cur]=1
        fi
        ;;
      "")
        break
        ;;
    esac

    printf "\033[%dA" "$total"
    print_menu
  done

  restore_cursor
  trap - INT TERM
  trap - EXIT
  echo

  # Assign results
  [ "${selected[0]}" -eq 1 ] && TRACK_DEVEL=true || TRACK_DEVEL=false
  [ "${selected[1]}" -eq 1 ] && PURGE_SNAP=true || PURGE_SNAP=false
  [ "${selected[2]}" -eq 1 ] && INSTALL_FLATPAK=true || INSTALL_FLATPAK=false
  [ "${selected[3]}" -eq 1 ] && DISABLE_PPAS=true || DISABLE_PPAS=false
  [ "${selected[4]}" -eq 1 ] && INSTALL_DEV_TOOLS=true || INSTALL_DEV_TOOLS=false
  [ "${selected[5]}" -eq 1 ] && CLEAN_SYSTEM=true || CLEAN_SYSTEM=false

  fancy_message info "Confirmed selections:"
  local any_selected=false
  if [ "${TRACK_DEVEL}" = "true" ]; then
    echo -e "    \033[1;32m✔\033[0m Track Ubuntu 'devel' series"
    any_selected=true
  fi
  if [ "${PURGE_SNAP}" = "true" ]; then
    echo -e "    \033[1;32m✔\033[0m Purge Snap completely and block snapd"
    any_selected=true
  fi
  if [ "${INSTALL_FLATPAK}" = "true" ]; then
    echo -e "    \033[1;32m✔\033[0m Install Flatpak & configure Flathub"
    any_selected=true
  fi
  if [ "${DISABLE_PPAS}" = "true" ]; then
    echo -e "    \033[1;32m✔\033[0m Disable third-party PPAs"
    any_selected=true
  fi
  if [ "${INSTALL_DEV_TOOLS}" = "true" ]; then
    echo -e "    \033[1;32m✔\033[0m Install Dev Essentials"
    any_selected=true
  fi
  if [ "${CLEAN_SYSTEM}" = "true" ]; then
    echo -e "    \033[1;32m✔\033[0m Full system cleanup"
    any_selected=true
  fi

  if [ "${any_selected}" = "false" ]; then
    echo -e "    (No tasks selected)"
  fi
  echo
}

FORCE=false
SKIP_DESKTOP=false
ASSUME_YES=false
DRY_RUN=false
FORCE_MENU=false
NO_MENU=false
PURGE_SNAP_CLI=""
INSTALL_FLATPAK_CLI=""
DEV_TOOLS_CLI=""
TRACK_DEVEL_CLI=""
DISABLE_PPAS_CLI=""
CLEAN_SYSTEM_CLI=""

# Take command line arguments
while [ $# -gt 0 ]; do
  case "${1}" in
    -h|--h|-help|--help)
      usage
      exit 0;;
    -m|--menu)
      FORCE_MENU=true
      shift;;
    --no-menu)
      NO_MENU=true
      shift;;
    -t|--track-devel)
      TRACK_DEVEL_CLI=true
      shift;;
    --no-devel)
      TRACK_DEVEL_CLI=false
      shift;;
    -p|--purge-snap)
      PURGE_SNAP_CLI=true
      shift;;
    --no-purge-snap)
      PURGE_SNAP_CLI=false
      shift;;
    --flatpak|--install-flatpak)
      INSTALL_FLATPAK_CLI=true
      shift;;
    --no-flatpak)
      INSTALL_FLATPAK_CLI=false
      shift;;
    --dev-tools)
      DEV_TOOLS_CLI=true
      shift;;
    --no-dev-tools)
      DEV_TOOLS_CLI=false
      shift;;
    --disable-ppas)
      DISABLE_PPAS_CLI=true
      shift;;
    --cleanup)
      CLEAN_SYSTEM_CLI=true
      shift;;
    --no-cleanup)
      CLEAN_SYSTEM_CLI=false
      shift;;
    -f|--force)
      FORCE=true
      shift;;
    -s|--skip-desktop-check)
      SKIP_DESKTOP=true
      shift;;
    -y|--yes)
      ASSUME_YES=true
      shift;;
    -d|--dry-run)
      DRY_RUN=true
      shift;;
    *)
      fancy_message error "\"${1}\" is not a supported parameter."
      usage
      exit 1;;
  esac
done

echo "Rolling Rebirth 🔄"

# Check if the user running the script is root
if [ "${DRY_RUN}" != "true" ] && [ "$(id -u)" -ne 0 ]; then
  fancy_message error "You need to be root. Run with sudo: sudo $0"
  exit 1
fi

if command -v lsb_release 1>/dev/null 2>&1; then
  fancy_message info "lsb_release detected."
else
  fancy_message error "lsb_release not detected. Quitting."
  exit 1
fi

DEB822_FILE="/etc/apt/sources.list.d/ubuntu.sources"
TRADITIONAL_FILE="/etc/apt/sources.list"

OS_CODENAME="$(lsb_release --codename --short 2>/dev/null || true)"
OS_ID="$(lsb_release --id --short 2>/dev/null || true)"
if [ "${OS_ID}" == "Ubuntu" ]; then
  fancy_message info "Ubuntu detected (${OS_CODENAME})."
else
  fancy_message error "${OS_ID:-Unknown OS} detected, which is not supported."
  exit 1
fi

OS_DESCRIPTION="$(lsb_release --description --short 2>/dev/null || true)"

# Decide whether to show interactive checklist
SHOW_INTERACTIVE=false
if [ "${ASSUME_YES}" = "true" ] || [ "${NO_MENU}" = "true" ]; then
  SHOW_INTERACTIVE=false
elif [ "${FORCE_MENU}" = "true" ] || [ -t 0 ]; then
  SHOW_INTERACTIVE=true
fi

if [ "${SHOW_INTERACTIVE}" = "true" ]; then
  interactive_checklist
else
  # Non-interactive / unattended mode defaults:
  # Everything is FALSE by default to prevent accidental destructive actions
  TRACK_DEVEL=${TRACK_DEVEL_CLI:-false}
  PURGE_SNAP=${PURGE_SNAP_CLI:-false}
  INSTALL_FLATPAK=${INSTALL_FLATPAK_CLI:-false}
  DISABLE_PPAS=${DISABLE_PPAS_CLI:-false}
  INSTALL_DEV_TOOLS=${DEV_TOOLS_CLI:-false}
  CLEAN_SYSTEM=${CLEAN_SYSTEM_CLI:-false}
fi

# If no tasks were chosen at all, exit safely
if [ "${TRACK_DEVEL}" != "true" ] && [ "${PURGE_SNAP}" != "true" ] && \
   [ "${INSTALL_FLATPAK}" != "true" ] && [ "${DISABLE_PPAS}" != "true" ] && \
   [ "${INSTALL_DEV_TOOLS}" != "true" ] && [ "${CLEAN_SYSTEM}" != "true" ]; then
  fancy_message warn "No tasks were selected. Run interactively or specify flags (e.g. -t, -p, --flatpak)."
  exit 0
fi

# Pre-flight check for Track Devel if selected
if [ "${TRACK_DEVEL}" = "true" ]; then
  already_tracking=false
  if [ -f "${DEB822_FILE}" ] && grep -E -q '^\s*Suites:.*\bdevel\b' "${DEB822_FILE}"; then
    already_tracking=true
  fi
  if [ -f "${TRADITIONAL_FILE}" ] && grep -E -q '^\s*deb\s+.*\bdevel\b' "${TRADITIONAL_FILE}"; then
    already_tracking=true
  fi

  if [ "${already_tracking}" = "true" ]; then
    fancy_message info "Already tracking the devel series. Repository configuration is already set to devel."
  else
    # Only enforce LTS/interim warning if not already on devel
    if [[ "${OS_DESCRIPTION}" == *"development branch"* ]]; then
      fancy_message info "${OS_DESCRIPTION} detected."
    elif [ "${FORCE}" = "true" ]; then
      fancy_message warn "${OS_DESCRIPTION} detected. Forcing switch to devel series as requested (--force)."
    elif [[ "${OS_DESCRIPTION}" == *"LTS"* ]]; then
      fancy_message error "${OS_DESCRIPTION} detected. Switching directly from a stable LTS release to devel is not recommended. Use --force to proceed anyway."
      exit 1
    else
      fancy_message error "${OS_DESCRIPTION} detected. Switching directly from an interim release to devel is not recommended. Use --force to proceed anyway."
      exit 1
    fi
  fi

  # Check desktop package if requested
  if [ "${SKIP_DESKTOP}" = "true" ]; then
    fancy_message info "Skipping desktop package check (--skip-desktop-check)."
  else
    META="$(
      dpkg-query -Wf '${Status}\t${Package}\n' \
        {{,k,l,x}ubuntu,ubuntu{-budgie,-mate,kylin,studio,unity,-cinnamon}}-desktop ubuntu-wsl \
        2>/dev/null |
      awk -F '\t' '($1 == "install ok installed") { print $2; exit; }' || true
    )"
    if [ -n "${META}" ]; then
      fancy_message info "Detected ${META}."
    else
      fancy_message error "No installed desktop packages were detected. Use --skip-desktop-check if running on Server/Minimal."
      exit 1
    fi
  fi

  # Warn about PPAs when switching to devel
  if grep_active_ppas -q || grep_active_deb822_ppas -q; then
    fancy_message warn "Active third-party PPAs or repositories were detected!"
    fancy_message warn "Most PPAs do not publish packages for the 'devel' series and will cause 404/dependency errors."
    if [ "${DISABLE_PPAS}" != "true" ]; then
      fancy_message warn "Consider enabling 'Disable active third-party PPAs' (--disable-ppas) to avoid repository conflicts."
    fi
  fi
fi

HOST_ARCH="$(uname --machine)"
if [ "${HOST_ARCH}" == "x86_64" ]; then
  ARCHIVE="http://archive.ubuntu.com/ubuntu"
  SEC_ARCHIVE="http://security.ubuntu.com/ubuntu"
else
  ARCHIVE="http://ports.ubuntu.com/ubuntu-ports"
  SEC_ARCHIVE="http://ports.ubuntu.com/ubuntu-ports"
fi

if [ "${DRY_RUN}" = "true" ]; then
  fancy_message info "[DRY RUN] Mode active. No modifications will be made."
  if [ "${TRACK_DEVEL}" = "true" ]; then
    if [ -f "${DEB822_FILE}" ]; then
      fancy_message info "[DRY RUN] Would update deb822 file: ${DEB822_FILE} (preserving existing mirror URIs)"
    else
      fancy_message info "[DRY RUN] Would update traditional file: ${TRADITIONAL_FILE} (preserving existing mirror URIs)"
    fi
    fancy_message info "[DRY RUN] Would simulate and execute: apt dist-upgrade (tracking devel)"
  fi
  if [ "${PURGE_SNAP}" = "true" ]; then
    fancy_message info "[DRY RUN] Would back up ~/snap directories to ~/snap.bak.<timestamp>"
    fancy_message info "[DRY RUN] Would purge all Snap packages, remove snapd, and pin /etc/apt/preferences.d/nosnap.pref"
  fi
  if [ "${INSTALL_FLATPAK}" = "true" ]; then
    fancy_message info "[DRY RUN] Would install Flatpak and configure Flathub"
  fi
  if [ "${DISABLE_PPAS}" = "true" ]; then
    fancy_message info "[DRY RUN] Would comment out third-party PPAs and repositories"
  fi
  if [ "${INSTALL_DEV_TOOLS}" = "true" ]; then
    fancy_message info "[DRY RUN] Would install Dev Essentials (curl, git, build-essential, zsh, htop)"
  fi
  if [ "${CLEAN_SYSTEM}" = "true" ]; then
    fancy_message info "[DRY RUN] Would run apt autoclean, clean, and autoremove"
  fi
  exit 0
fi

# Confirmation prompt if not unattended
if [ "${ASSUME_YES}" != "true" ]; then
  if [ "${PURGE_SNAP}" = "true" ]; then
    fancy_message warn "NOTE: Selected tasks include purging Snap. User application profiles in ~/snap will be backed up to ~/snap.bak.<timestamp>."
  fi
  read -p "Are you sure you want to proceed with the selected tasks? [y/N] " -n 1 -r
  echo
  if [[ ! "${REPLY}" =~ ^[Yy]$ ]]; then
    fancy_message warn "Operation cancelled by user."
    exit 0
  fi
fi

# Variable to track non-fatal errors
EXECUTION_ERROR=false

# 1. Disable PPAs if selected
if [ "${DISABLE_PPAS}" = "true" ]; then
  if grep_active_ppas -q; then
    grep_active_ppas -lZ | xargs -r0 -- sed -i.orig -e 's/^\s*[^#\s]/# &/'
  fi
  if grep_active_deb822_ppas -q; then
    grep_active_deb822_ppas -lZ | xargs -r0 -- sed -i.orig -e 's/^\s*[^#\s]/# &/'
  fi
  fancy_message info "Disabled third-party PPAs and repositories."
fi

# 2. Purge Snap if selected
# Note: If snap purge fails, abort immediately to prevent running dist-upgrade in an unstable state
if [ "${PURGE_SNAP}" = "true" ]; then
  if ! purge_snap_packages; then
    fancy_message error "Snap purge failed! Aborting remaining tasks to prevent system inconsistency."
    exit 1
  fi
  # Print the browser & profile restoration guide immediately so the user always has it
  # even if any subsequent tasks (like dist-upgrade) encounter issues
  show_browser_restoration_guide
fi

# 3. Track Devel series if selected
if [ "${TRACK_DEVEL}" = "true" ]; then
  if [ -f "${DEB822_FILE}" ] && [ -s "${DEB822_FILE}" ]; then
    fancy_message info "Updating deb822 sources (${DEB822_FILE}) while preserving configured mirrors..."
    update_deb822_sources "${DEB822_FILE}"

    # Disable conflicting active deb entries in traditional sources.list if present
    if [ -f "${TRADITIONAL_FILE}" ] && grep -E -q '^\s*deb(-src)?[[:space:]]' "${TRADITIONAL_FILE}"; then
      fancy_message info "Disabling conflicting entries in ${TRADITIONAL_FILE}."
      cp "${TRADITIONAL_FILE}" "${TRADITIONAL_FILE}.${OS_CODENAME}.bak"
      sed -i -E 's/^[[:space:]]*deb(-src)?/# &/' "${TRADITIONAL_FILE}"
    fi
  elif [ -f "${TRADITIONAL_FILE}" ] && [ -s "${TRADITIONAL_FILE}" ]; then
    fancy_message info "Updating traditional sources (${TRADITIONAL_FILE}) while preserving configured mirrors..."
    update_traditional_sources "${TRADITIONAL_FILE}"
  else
    fancy_message info "Configuring default sources (${DEB822_FILE})..."
    write_default_deb822_sources "${DEB822_FILE}"
  fi

  fancy_message info "Updating package lists for devel series..."
  if ! apt-get -y update; then
    fancy_message error "apt-get update failed on devel repositories. Aborting dist-upgrade to protect your system."
    exit 1
  fi

  # Simulate dist-upgrade first before applying changes!
  fancy_message info "Simulating dist-upgrade (dry-run check)..."
  if ! apt-get -s dist-upgrade >/dev/null 2>&1; then
    fancy_message error "Simulation failed: 'apt-get -s dist-upgrade' detected package conflicts or broken dependencies."
    fancy_message error "Aborting dist-upgrade to protect your system from becoming unbootable."
    exit 1
  fi

  fancy_message info "Simulation passed. Performing actual dist-upgrade to devel series..."
  if ! apt-get -y dist-upgrade; then
    fancy_message error "apt-get dist-upgrade encountered errors."
    exit 1
  fi
fi

# 4. Install Flatpak if selected
if [ "${INSTALL_FLATPAK}" = "true" ]; then
  if ! install_flatpak_support; then
    EXECUTION_ERROR=true
  fi
fi

# 5. Install Dev Essentials if selected
if [ "${INSTALL_DEV_TOOLS}" = "true" ]; then
  if ! install_dev_tools; then
    EXECUTION_ERROR=true
  fi
fi

# 6. System Cleanup if selected
if [ "${CLEAN_SYSTEM}" = "true" ]; then
  fancy_message info "Cleaning up system caches and unused packages..."
  apt-get -y autoclean || true
  apt-get -y clean || true
  apt-get -y autoremove || true
fi

# Final status report
if [ "${EXECUTION_ERROR}" = "true" ]; then
  fancy_message error "Rolling Rebirth finished with warnings/errors. Please review the output above."
  exit 1
else
  fancy_message info "Your Rolling Rebirth is ready."
  if [ -f "$(dirname "$0")/logo.txt" ]; then
    cat "$(dirname "$0")/logo.txt"
  fi
fi
