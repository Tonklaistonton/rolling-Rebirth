#!/usr/bin/env bash

function usage () {
  echo
  echo "Rolling Rebirth 🔄"
  echo "Convert Ubuntu into a rolling release tracking the devel series."
  echo
  echo "Usage:"
  echo "  sudo $0 [OPTIONS]"
  echo
  echo "Options:"
  echo "  -f, --force               Force tracking devel series even on stable LTS/interim releases"
  echo "  -s, --skip-desktop-check  Skip checking for desktop package (e.g. for Server/Minimal)"
  echo "  -y, --yes                 Automatic yes to prompts (unattended mode)"
  echo "  -d, --dry-run             Perform pre-flight checks and display plan without making changes"
  echo "  -h, --help                Show this help message"
  echo
}

function fancy_message() {
    # $1 = type , $2 = message
    # Message types
    # info
    # warn
    # error
    if [ -z "${1}" ] || [ -z "${2}" ]; then
      return 2
    fi

    local RED='\e[31m' GREEN='\e[32m' YELLOW='\e[33m' RESET='\e[0m'
    local -A FORMATS=(
      [info]="[${GREEN}+${RESET}] INFO"
      [warn]="[${YELLOW}*${RESET}] WARNING"
      [error]="[${RED}!${RESET}] ERROR"
    )
    local MESSAGE_TYPE="${1}" MESSAGE="${2}"

    printf "  ${FORMATS["${MESSAGE_TYPE}"]-"[?] UNKNOWN"}: %s\\n" "${MESSAGE}"
}

function grep_active_ppas ()
{
  grep "$@" -e '^\s*deb\s' -R --include='*.list' --exclude='*.orig' /etc/apt/sources.list.d 2>/dev/null
}

function grep_active_deb822_ppas ()
{
  grep "$@" -e '^\s*Suites:' -R --include='*.sources' --exclude='ubuntu.sources*' --exclude='*.orig' /etc/apt/sources.list.d 2>/dev/null
}

FORCE=false
SKIP_DESKTOP=false
ASSUME_YES=false
DRY_RUN=false

# Take command line arguments
while [ $# -gt 0 ]; do
  case "${1}" in
    -h|--h|-help|--help)
      usage
      exit 0;;
    -f|--force)
      FORCE=true
      shift;;
    -s|--skip-desktop-check)
      SKIP_DESKTOP=true
      shift;;
    -y|--yes)
      ASSUME_YES=true
      shift;;
    -d|--dry-run)
      DRY_RUN=true
      shift;;
    *)
      fancy_message error "\"${1}\" is not a supported parameter."
      usage
      exit 1;;
  esac
done

echo "Rolling Rebirth 🔄"

# Check if the user running the script is root
if [ "${DRY_RUN}" != "true" ] && [ "$(id -u)" -ne 0 ]; then
  fancy_message error "You need to be root. Run with sudo: sudo $0"
  exit 1
fi

if which lsb_release 1>/dev/null 2>&1; then
  fancy_message info "lsb_release detected."
else
  fancy_message error "lsb_release not detected. Quitting."
  exit 1
fi

DEB822_FILE="/etc/apt/sources.list.d/ubuntu.sources"
TRADITIONAL_FILE="/etc/apt/sources.list"

already_tracking=false
if [ -f "${DEB822_FILE}" ] && grep -E -q '^\s*Suites:.*\bdevel\b' "${DEB822_FILE}"; then
  already_tracking=true
fi
if [ -f "${TRADITIONAL_FILE}" ] && grep -E -q '^\s*deb\s+.*\bdevel\b' "${TRADITIONAL_FILE}"; then
  already_tracking=true
fi

if [ "${already_tracking}" = "true" ]; then
  fancy_message error "Already tracking the devel series. Nothing to do."
  exit 1
fi

OS_CODENAME=$(lsb_release --codename --short 2>/dev/null)
OS_ID=$(lsb_release --id --short 2>/dev/null)
if [ "${OS_ID}" == "Ubuntu" ]; then
  fancy_message info "Ubuntu detected (${OS_CODENAME})."
else
  fancy_message error "${OS_ID:-Unknown OS} detected, which is not supported."
  exit 1
fi

OS_DESCRIPTION=$(lsb_release --description --short 2>/dev/null)
if [[ "${OS_DESCRIPTION}" == *"development branch"* ]]; then
  fancy_message info "${OS_DESCRIPTION} detected."
elif [ "${FORCE}" = "true" ]; then
  fancy_message warn "${OS_DESCRIPTION} detected. Forcing switch to devel series as requested (--force)."
elif [[ "${OS_DESCRIPTION}" == *"LTS"* ]]; then
  fancy_message error "${OS_DESCRIPTION} detected. Switching directly from a stable LTS release to devel is not recommended. Use --force to proceed anyway."
  exit 1
else
  fancy_message error "${OS_DESCRIPTION} detected. Switching directly from an interim release to devel is not recommended. Use --force to proceed anyway."
  exit 1
fi

if [ "${SKIP_DESKTOP}" = "true" ]; then
  fancy_message info "Skipping desktop package check (--skip-desktop-check)."
else
  META="$(
    dpkg-query -Wf '${Status}\t${Package}\n' \
      {{,k,l,x}ubuntu,ubuntu{-budgie,-mate,kylin,studio,unity,-cinnamon}}-desktop ubuntu-wsl \
      2>/dev/null |
    awk -F '\t' '($1 == "install ok installed") { print $2; exit; }')"
  if [ -n "${META}" ]; then
    fancy_message info "Detected ${META}."
  else
    fancy_message error "No installed desktop packages were detected. Use --skip-desktop-check if running on Server/Minimal."
    exit 1
  fi
fi

has_ppas=false
if grep_active_ppas -q || grep_active_deb822_ppas -q; then
  has_ppas=true
fi

if [ "${has_ppas}" = "true" ]; then
  fancy_message warn "PPAs or third-party repositories detected. You are responsible for PPA migrations in the future."
  if [ "${ASSUME_YES}" = "true" ]; then
    DISABLE_PPA="y"
  elif [ "${DRY_RUN}" = "true" ]; then
    DISABLE_PPA="n"
  else
    read -p "  Do you want to disable third-party repositories? [y/N] " -n 1 -r
    echo
    DISABLE_PPA="${REPLY}"
  fi

  if [[ "${DISABLE_PPA}" =~ ^[Yy]$ ]]; then
    if [ "${DRY_RUN}" != "true" ]; then
      if grep_active_ppas -q; then
        grep_active_ppas -lZ | xargs -r0 -- sed -i.orig -e 's/^\s*[^#\s]/# &/'
      fi
      if grep_active_deb822_ppas -q; then
        grep_active_deb822_ppas -lZ | xargs -r0 -- sed -i.orig -e 's/^\s*[^#\s]/# &/'
      fi
      fancy_message info "Disabled active third-party repositories."
    else
      fancy_message info "[DRY RUN] Would disable active third-party repositories."
    fi
  fi
else
  fancy_message info "No third-party PPAs detected, this is good."
fi

fancy_message info "All pre-flight checks passed."

HOST_ARCH="$(uname --machine)"
if [ "${HOST_ARCH}" == "x86_64" ]; then
  ARCHIVE="http://archive.ubuntu.com/ubuntu"
  SEC_ARCHIVE="http://security.ubuntu.com/ubuntu"
else
  ARCHIVE="http://ports.ubuntu.com/ubuntu-ports"
  SEC_ARCHIVE="http://ports.ubuntu.com/ubuntu-ports"
fi

if [ "${DRY_RUN}" = "true" ]; then
  fancy_message info "[DRY RUN] Mode active. No modifications will be made."
  if [ -f "${DEB822_FILE}" ]; then
    fancy_message info "[DRY RUN] Detected modern deb822 format."
    fancy_message info "[DRY RUN] Would update: ${DEB822_FILE}"
    fancy_message info "[DRY RUN] Target suites: devel, devel-updates, devel-backports, devel-security"
  else
    fancy_message info "[DRY RUN] Detected traditional format."
    fancy_message info "[DRY RUN] Would update: ${TRADITIONAL_FILE}"
  fi
  fancy_message info "[DRY RUN] Architecture: ${HOST_ARCH}"
  fancy_message info "[DRY RUN] Would execute: apt autoclean, clean, update, dist-upgrade, autoremove"
  exit 0
fi

if [ "${ASSUME_YES}" = "true" ]; then
  REPLY="y"
else
  read -p "Are you sure you want to start tracking the devel series? [y/N] " -n 1 -r
  echo
fi

if [[ "${REPLY}" =~ ^[Yy]$ ]]; then
  if [ -f "${DEB822_FILE}" ]; then
    fancy_message info "Configuring deb822 sources (${DEB822_FILE})."
    cp "${DEB822_FILE}" "${DEB822_FILE}.${OS_CODENAME}.bak"

    SIGNED_BY=""
    if [ -f "/usr/share/keyrings/ubuntu-archive-keyring.gpg" ]; then
      SIGNED_BY="Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg"
    fi

    cat << EOF > "${DEB822_FILE}"
Types: deb
URIs: ${ARCHIVE}
Suites: devel devel-updates devel-backports
Components: main restricted universe multiverse
${SIGNED_BY}

Types: deb
URIs: ${SEC_ARCHIVE}
Suites: devel-security
Components: main restricted universe multiverse
${SIGNED_BY}
EOF

    # Disable conflicting active deb entries in traditional sources.list if present
    if [ -f "${TRADITIONAL_FILE}" ] && grep -E -q '^\s*deb\s' "${TRADITIONAL_FILE}"; then
      fancy_message info "Disabling conflicting entries in ${TRADITIONAL_FILE}."
      cp "${TRADITIONAL_FILE}" "${TRADITIONAL_FILE}.${OS_CODENAME}.bak"
      sed -i -e 's/^\s*deb/# deb/' "${TRADITIONAL_FILE}"
    fi
  else
    fancy_message info "Configuring traditional sources (${TRADITIONAL_FILE})."
    if [ -f "${TRADITIONAL_FILE}" ]; then
      cp "${TRADITIONAL_FILE}" "${TRADITIONAL_FILE}.${OS_CODENAME}.bak"
    fi
    cat << EOF > "${TRADITIONAL_FILE}"
# See http://help.ubuntu.com/community/UpgradeNotes for how to upgrade to
# newer versions of the distribution.
deb ${ARCHIVE} devel main restricted
# deb-src ${ARCHIVE} devel main restricted

## Major bug fix updates produced after the final release of the
## distribution.
deb ${ARCHIVE} devel-updates main restricted
# deb-src ${ARCHIVE} devel-updates main restricted

## N.B. software from this repository is ENTIRELY UNSUPPORTED by the Ubuntu
## team. Also, please note that software in universe WILL NOT receive any
## review or updates from the Ubuntu security team.
deb ${ARCHIVE} devel universe
# deb-src ${ARCHIVE} devel universe
deb ${ARCHIVE} devel-updates universe
# deb-src ${ARCHIVE} devel-updates universe

## N.B. software from this repository is ENTIRELY UNSUPPORTED by the Ubuntu
## team, and may not be under a free licence. Please satisfy yourself as to
## your rights to use the software. Also, please note that software in
## multiverse WILL NOT receive any review or updates from the Ubuntu
## security team.
deb ${ARCHIVE} devel multiverse
# deb-src ${ARCHIVE} devel multiverse
deb ${ARCHIVE} devel-updates multiverse
# deb-src ${ARCHIVE} devel-updates multiverse

## N.B. software from this repository may not have been tested as
## extensively as that contained in the main release, although it includes
## newer versions of some applications which may provide useful features.
## Also, please note that software in backports WILL NOT receive any review
## or updates from the Ubuntu security team.
deb ${ARCHIVE} devel-backports main restricted universe multiverse
# deb-src ${ARCHIVE} devel-backports main restricted universe multiverse

deb ${SEC_ARCHIVE} devel-security main restricted
# deb-src ${SEC_ARCHIVE} devel-security main restricted
deb ${SEC_ARCHIVE} devel-security universe
# deb-src ${SEC_ARCHIVE} devel-security universe
deb ${SEC_ARCHIVE} devel-security multiverse
# deb-src ${SEC_ARCHIVE} devel-security multiverse
EOF
  fi

  fancy_message info "Switching to devel series."
  apt -y autoclean
  apt -y clean
  apt -y update
  apt -y dist-upgrade
  apt -y autoremove
  fancy_message info "Your Rolling Rebirth is ready."

  if [ -f "$(dirname "$0")/logo.txt" ]; then
    cat "$(dirname "$0")/logo.txt"
  fi
fi
