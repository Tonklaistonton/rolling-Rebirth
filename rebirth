#!/usr/bin/env bash
set -euo pipefail

function usage () {
  echo
  echo "Rolling Rebirth 🔄"
  echo "Convert Ubuntu into a rolling release tracking the devel series, with modular tweaks."
  echo
  echo "Usage:"
  echo "  sudo $0 [OPTIONS]"
  echo
  echo "Options:"
  echo "  -m, --menu                Force interactive checklist menu (default in terminal)"
  echo "      --no-menu             Skip interactive menu and use command line flags"
  echo "  -t, --track-devel         Switch Ubuntu repositories to 'devel' series and dist-upgrade"
  echo "      --no-devel            Explicitly do not switch repositories to devel series"
  echo "  -p, --purge-snap          Purge all snap packages, remove snapd, and pin APT against snapd"
  echo "      --no-purge-snap       Explicitly keep snapd and snap packages"
  echo "      --flatpak             Install Flatpak and configure Flathub repository"
  echo "      --no-flatpak          Explicitly do not install Flatpak"
  echo "      --dev-tools           Install developer essentials (curl, git, build-essential, zsh, htop)"
  echo "      --no-dev-tools        Explicitly do not install developer essentials"
  echo "      --disable-ppas        Disable active third-party PPAs and repositories"
  echo "      --cleanup             Clean up system caches and unused packages (autoclean/autoremove)"
  echo "      --no-cleanup          Explicitly skip system cleanup"
  echo "  -f, --force               Force tracking devel series even on stable LTS/interim releases"
  echo "  -s, --skip-desktop-check  Skip checking for desktop package (e.g. for Server/Minimal)"
  echo "  -y, --yes                 Automatic yes to all prompts (unattended mode, skips menu)"
  echo "  -d, --dry-run             Perform pre-flight checks and display plan without making changes"
  echo "  -h, --help                Show this help message"
  echo
}

function fancy_message() {
    # $1 = type , $2 = message
    # Message types: info, warn, error
    if [ -z "${1:-}" ] || [ -z "${2:-}" ]; then
      return 2
    fi

    local RED='\e[31m' GREEN='\e[32m' YELLOW='\e[33m' RESET='\e[0m'
    local -A FORMATS=(
      [info]="[${GREEN}+${RESET}] INFO"
      [warn]="[${YELLOW}*${RESET}] WARNING"
      [error]="[${RED}!${RESET}] ERROR"
    )
    local MESSAGE_TYPE="${1}" MESSAGE="${2}"

    printf "  ${FORMATS["${MESSAGE_TYPE}"]-"[?] UNKNOWN"}: %s\\n" "${MESSAGE}"
}

function grep_active_ppas ()
{
  grep "$@" -e '^\s*deb\s' -R --include='*.list' --exclude='*.orig' /etc/apt/sources.list.d 2>/dev/null
}

function grep_active_deb822_ppas ()
{
  grep "$@" -e '^\s*Suites:' -R --include='*.sources' --exclude='ubuntu.sources*' --exclude='*.orig' /etc/apt/sources.list.d 2>/dev/null
}

LAST_SNAP_BACKUP=""

function backup_user_snap_data () {
  local timestamp="${1}"

  for user_home in /home/* /root; do
    [ -d "${user_home}" ] || continue
    local snap_dir="${user_home}/snap"
    if [ -d "${snap_dir}" ]; then
      local backup_dir="${user_home}/snap.bak.${timestamp}"
      fancy_message warn "Backing up user application data: ${snap_dir} -> ${backup_dir}"
      if cp -a "${snap_dir}" "${backup_dir}"; then
        chown -R --reference="${user_home}" "${backup_dir}" 2>/dev/null || true
        fancy_message info "Backup created: ${backup_dir}"
        LAST_SNAP_BACKUP="${backup_dir}"
      else
        fancy_message error "Failed to back up ${snap_dir}! Aborting snap purge to protect user data."
        return 1
      fi
    fi
  done

  return 0
}

function purge_snap_packages () {
  local timestamp
  timestamp="$(date +%Y%m%d_%H%M%S)"

  fancy_message warn "Initiating Snap purge..."

  # Step 1: Backup user profiles and data first!
  if ! backup_user_snap_data "${timestamp}"; then
    fancy_message error "Snap purge aborted due to backup failure."
    return 1
  fi

  # Step 2: Remove installed snap packages
  # Note: removed without --purge so snapd creates internal backup snapshots in /var/lib/snapd/snapshots/
  if command -v snap 1>/dev/null 2>&1; then
    # Phase 1: Normal desktop applications
    for s in $(snap list 2>/dev/null | awk 'NR>1 {print $1}'); do
      case "${s}" in
        core*|bare|snapd|base*|gtk-common-themes*|gnome-*) ;;
        *)
          fancy_message info "Removing snap application: ${s}"
          snap remove "${s}" || fancy_message warn "snap remove reported an issue for: ${s}"
          ;;
      esac
    done

    # Phase 2: Themes and desktop runtimes
    for s in $(snap list 2>/dev/null | awk 'NR>1 {print $1}'); do
      case "${s}" in
        core*|bare|snapd) ;;
        *)
          fancy_message info "Removing snap runtime: ${s}"
          snap remove "${s}" || fancy_message warn "snap remove reported an issue for: ${s}"
          ;;
      esac
    done

    # Phase 3: Core runtimes and snapd
    for s in $(snap list 2>/dev/null | awk 'NR>1 {print $1}'); do
      fancy_message info "Removing core snap: ${s}"
      snap remove "${s}" || fancy_message warn "snap remove reported an issue for: ${s}"
    done
  fi

  # Step 3: Preserve snapd-generated snapshots before stopping service and removing directories
  if [ -d /var/lib/snapd/snapshots ] && [ -n "$(ls -A /var/lib/snapd/snapshots 2>/dev/null)" ]; then
    local sys_backup="/var/backups/snapd-snapshots.${timestamp}"
    fancy_message info "Preserving snapd internal snapshots -> ${sys_backup}"
    mkdir -p "/var/backups"
    if cp -a /var/lib/snapd/snapshots "${sys_backup}"; then
      fancy_message info "Snapshots preserved at: ${sys_backup}"
    else
      fancy_message warn "Could not back up snapd internal snapshots from /var/lib/snapd/snapshots to ${sys_backup}."
    fi
  fi

  # Step 4: Stop and disable snap services
  fancy_message info "Stopping snapd systemd services..."
  systemctl stop snapd.service snapd.socket snapd.seeded.service 2>/dev/null || true
  systemctl disable snapd.service snapd.socket snapd.seeded.service 2>/dev/null || true

  # Step 5: Purge snapd Debian package via APT
  fancy_message info "Purging snapd Debian package..."
  if ! apt-get purge -y snapd; then
    fancy_message error "APT reported errors while purging snapd."
    return 1
  fi
  apt-get autoremove --purge -y || true

  # Step 6: Clean up leftover snap directories and active ~/snap
  # Note: User data is preserved in ~/snap.bak.<timestamp> and snapshots in /var/backups/
  fancy_message info "Removing leftover snap directories..."
  rm -rf /var/cache/snapd /var/snap /snap /var/lib/snapd /etc/systemd/system/snap* 2>/dev/null || true
  rm -rf /root/snap 2>/dev/null || true
  for user_home in /home/*; do
    if [ -d "${user_home}/snap" ]; then
      rm -rf "${user_home}/snap" 2>/dev/null || true
    fi
  done

  # Step 7: Block snapd from being reinstalled (APT pinning)
  fancy_message info "Pinning APT preferences to block snapd from being reinstalled..."
  cat << 'EOF' > /etc/apt/preferences.d/nosnap.pref
# Created by Rolling Rebirth
# Prevent snapd from being reinstalled automatically by Ubuntu/APT
Package: snapd
Pin: release *
Pin-Priority: -10
EOF

  # Step 8: Post-purge verification
  # Clear Bash command hash table cache so command -v does not return stale cached path
  hash -r

  local verify_failed=false
  if [ -x /usr/bin/snap ] || [ -f /usr/bin/snap ] || [ -x /snap/bin/snap ] || command -v snap 1>/dev/null 2>&1; then
    fancy_message error "Verification failed: 'snap' binary is still present on the system."
    verify_failed=true
  fi
  if dpkg-query -W -f='${Status}' snapd 2>/dev/null | grep -q "install ok installed"; then
    fancy_message error "Verification failed: snapd package is still marked as installed."
    verify_failed=true
  fi

  if [ "${verify_failed}" = "true" ]; then
    fancy_message error "Snap purge was incomplete. Please review errors above."
    return 1
  else
    fancy_message info "Verification passed: Snap has been completely purged and blocked."
    return 0
  fi
}

function install_flatpak_support () {
  fancy_message info "Installing Flatpak..."
  if ! apt-get update; then
    fancy_message warn "apt-get update reported issues; attempting to continue with Flatpak installation..."
  fi
  if ! apt-get install -y flatpak; then
    fancy_message error "Failed to install flatpak package via APT."
    return 1
  fi

  if dpkg -s gnome-software 1>/dev/null 2>&1; then
    apt-get install -y gnome-software-plugin-flatpak || fancy_message warn "Could not install gnome-software-plugin-flatpak."
  fi

  hash -r
  if ! command -v flatpak 1>/dev/null 2>&1; then
    fancy_message error "Verification failed: 'flatpak' command not found after installation."
    return 1
  fi

  fancy_message info "Adding Flathub repository..."
  if ! flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo; then
    fancy_message error "Failed to add Flathub repository."
    return 1
  fi

  fancy_message info "Verification passed: Flatpak and Flathub installed successfully."
  return 0
}

function install_dev_tools () {
  fancy_message info "Installing Dev Essentials (curl, git, build-essential, zsh, htop)..."
  apt-get update || fancy_message warn "apt-get update reported issues."
  if ! apt-get install -y curl git build-essential zsh htop; then
    fancy_message error "Failed to install some Dev Essentials packages."
    return 1
  fi
  hash -r
  fancy_message info "Verification passed: Dev Essentials installed successfully."
  return 0
}

function update_deb822_sources() {
  local target_file="${1}"
  local backup_file="${1}.${OS_CODENAME}.bak"

  cp "${target_file}" "${backup_file}"

  # Use awk to update Suites in-place while strictly preserving all existing URIs, Components, Signed-By, and comments
  local tmp_file
  tmp_file="$(mktemp)"
  awk '
    /^[[:space:]]*Suites:.*-security/ { print "Suites: devel-security"; next }
    /^[[:space:]]*Suites:/ { print "Suites: devel devel-updates devel-backports"; next }
    { print }
  ' "${target_file}" > "${tmp_file}"
  mv "${tmp_file}" "${target_file}"
  chmod 644 "${target_file}"
}

function write_default_deb822_sources() {
  local target_file="${1}"
  local signed_by=""
  if [ -f "/usr/share/keyrings/ubuntu-archive-keyring.gpg" ]; then
    signed_by="Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg"
  fi

  cat << EOF > "${target_file}"
Types: deb
URIs: ${ARCHIVE}
Suites: devel devel-updates devel-backports
Components: main restricted universe multiverse
${signed_by}

Types: deb
URIs: ${SEC_ARCHIVE}
Suites: devel-security
Components: main restricted universe multiverse
${signed_by}
EOF
}

function update_traditional_sources() {
  local target_file="${1}"
  local backup_file="${1}.${OS_CODENAME}.bak"

  cp "${target_file}" "${backup_file}"
  # Safely replace only the exact codename with 'devel' across all deb and deb-src lines,
  # perfectly preserving user mirrors, options/brackets, and -updates / -backports / -security
  sed -i -E "s/\b${OS_CODENAME}\b/devel/g" "${target_file}"
}

